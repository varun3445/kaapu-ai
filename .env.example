# Copy this file to .env.local for local dev, or add these as Vercel env vars.
# Get these from: supabase.com → Your project → Settings → API

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Canonical production domain used for auth email redirects (password reset,
# signup confirmation, OAuth). Without this, redirects fall back to whatever
# domain the app happened to be running on when the request was made — which
# on Vercel is the per-deployment preview URL, not your real production
# domain. Set this in Vercel's Project Settings → Environment Variables
# (Production) to your real domain, e.g.:
VITE_SITE_URL=https://kaapu-ai.vercel.app
