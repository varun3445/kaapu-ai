17:34:46.694 {"configDirectory":".storybook","mainConfig":{"code":"import type { StorybookConfig } from '@storybook/react-vite';\nimport { fileURLToPath } from 'url';\nimport path from 'path';\nimport type { Plugin } from 'vite';\n\nconst __dirname = path.dirname(fileURLToPath(import.meta.url));\n\n/** Intercept AppContext and supabase imports at resolve-time, before Vite adds extensions */\nfunction mockPlugin(): Plugin {\n  const mockAppCtx  = path.resolve(__dirname, 'MockAppContext.jsx')\n  const mockSupabase = path.resolve(__dirname, 'MockSupabase.js')\n\n  return {\n    name: 'kaapu-storybook-mocks',\n    enforce: 'pre',\n    resolveId(source, importer) {\n      // Convert file:// absolute URLs (generated by MDX compiler) to real filesystem paths\n      if (source.startsWith('file://')) return fileURLToPath(source)\n      if (!importer) return null\n      // Intercept any import path that ends with /context/AppContext (with or without extension)\n      if (/\\/context\\/AppContext(\\.jsx?)?$/.test(source)) return mockAppCtx\n      if (/\\/supabase(\\.js?)?$/.test(source))             return mockSupabase\n      // Also handle relative-resolved paths\n      const resolved = path.resolve(path.dirname(importer), source)\n      if (resolved === path.resolve(__dirname, '../src/context/AppContext.jsx') ||\n          resolved === path.resolve(__dirname, '../src/context/AppContext')) {\n        return mockAppCtx\n      }\n      if (resolved === path.resolve(__dirname, '../src/supabase.js') ||\n          resolved === path.resolve(__dirname, '../src/supabase')) {\n        return mockSupabase\n      }\n      return null\n    },\n  }\n}\n\n/**\n * Storybook 10's MDX compiler embeds absolute file:// URLs in compiled output,\n * e.g. import ... from \"file:///path/to/mdx-react-shim.js\"\n * Vite's import-analysis chokes on these. Fix: rewrite them to bare paths\n * after the MDX transform runs (enforce: 'post' ensures we see compiled output).\n */\nfunction mdxFileUrlFix(): Plugin {\n  return {\n    name: 'kaapu-mdx-fileurl-fix',\n    enforce: 'post',\n    transform(code, id) {\n      if (!id.endsWith('.mdx')) return null\n      // Replace: from \"file:///absolute/path\" → from \"/absolute/path\"\n      const fixed = code.replace(/from\\s+\"file:\\/\\/([^\"]+)\"/g, 'from \"$1\"')\n      return fixed !== code ? { code: fixed, map: null } : null\n    },\n  }\n}\n\nconst config: StorybookConfig = {\n  stories: [\n    '../src/**/*.mdx',\n    '../src/**/*.stories.@(js|jsx|mjs|ts|tsx)',\n  ],\n  addons: [\n    '@chromatic-com/storybook',\n    '@storybook/addon-vitest',\n    '@storybook/addon-a11y',\n    '@storybook/addon-docs',\n    '@storybook/addon-mcp',\n  ],\n  framework: '@storybook/react-vite',\n  staticDirs: ['../public'],\n  async viteFinal(config) {\n    config.plugins = [...(config.plugins ?? []), mockPlugin(), mdxFileUrlFix()]\n    // In Storybook 10 @storybook/blocks is not a separate package; blocks live in addon-docs\n    config.resolve = config.resolve ?? {}\n    config.resolve.alias = {\n      ...(config.resolve.alias as Record<string, string> ?? {}),\n      '@storybook/blocks': '@storybook/addon-docs/blocks',\n    }\n    return config\n  },\n};\nexport default config;\n"}}
